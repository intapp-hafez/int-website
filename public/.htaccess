# ----------------------------------------------------------------------
# Integrated Technics — Enterprise HTTP Security Headers (A+ Grade)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  # 1. Content Security Policy
  Header always set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval' wss:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://www.google.com https://maps.google.com https://challenges.cloudflare.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self';"
  Header set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval' wss:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://maps.googleapis.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https://www.google.com https://maps.google.com https://challenges.cloudflare.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self';"

  # 2. Permissions Policy (Feature Policy)
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), screen-wake-lock=()"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), screen-wake-lock=()"

  # 3. Anti-Clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  Header set X-Frame-Options "SAMEORIGIN"

  # 4. Anti-MIME Sniffing
  Header always set X-Content-Type-Options "nosniff"
  Header set X-Content-Type-Options "nosniff"

  # 5. Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # 6. HTTP Strict Transport Security (HSTS)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # 7. Cross-Origin Protection
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-XSS-Protection "1; mode=block"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# ----------------------------------------------------------------------
# Single Page Application (SPA) Fallback Routing
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
